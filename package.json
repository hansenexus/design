{
  "name": "hansenexus-design",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "ratchet": "bun scripts/ratchet.ts && bun scripts/levels.ts",
    "build": "bun run --filter '*' build",
    "contrast": "bun run --filter '*' contrast",
    "test": "bun test scripts && bun run --filter '*' test",
    "screenshots": "bun run --filter @hansenexus/ui screenshots",
    "swift": "bun run --filter @hansenexus/tokens swift",
    "brand": "bun scripts/brand.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
