{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": [
    "scripts/**/*.ts",
    "packages/*/scripts/**/*.ts",
    "packages/*/tests/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/gallery/**/*.tsx",
    "packages/*/screenshots/**/*.ts",
    "packages/*/*.config.ts"
  ]
}
