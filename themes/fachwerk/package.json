{
  "name": "@hansenexus/theme-fachwerk",
  "version": "0.2.0",
  "description": "fachwerk's theme pack for the hansenexus design system: direction B \"Fachwerk\" as recipe tokens (2px beams, square controls, no shadows, brace motifs) and skins for @hansenexus/ui.",
  "license": "MIT",
  "keywords": [
    "design-tokens",
    "theme",
    "react",
    "tailwindcss",
    "design-system"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hansenexus/design.git",
    "directory": "themes/fachwerk"
  },
  "bugs": "https://github.com/hansenexus/design/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "files": [
    "dist/",
    "pack.json",
    "fachwerk/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ../../scripts/theme-build.ts",
    "prepublishOnly": "bun ../../scripts/theme-build.ts"
  },
  "peerDependencies": {
    "@hansenexus/tokens": "^0.13.0",
    "@hansenexus/ui": "^0.7.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@hansenexus/tokens": "workspace:*",
    "@hansenexus/ui": "workspace:*",
    "@types/react": "19.3.0",
    "react": "19.3.0"
  }
}
