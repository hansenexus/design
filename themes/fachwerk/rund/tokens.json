{
  "size": {
    "$description": "Direction rund (design#243): the proof that a pack changes the mask, not only the colour. fachwerk's colours and fonts on a round, roomier mask: taller controls, wider padding, larger control type. Colours per mode in tokens.dark.json and tokens.light.json, the same as the default direction.",
    "$type": "dimension",
    "row": { "$value": "{density.comfortable.row}" },
    "target": { "$value": "{density.comfortable.target}" },
    "control-xs": { "$value": "28px" },
    "control-sm": { "$value": "36px" },
    "control-md": { "$value": "40px" },
    "control-lg": { "$value": "52px" },
    "control-pad-xs": { "$value": "10px" },
    "control-pad-sm": { "$value": "14px" },
    "control-pad-md": { "$value": "18px" },
    "control-pad-lg": { "$value": "22px" },
    "field": { "$value": "44px" },
    "field-pad": { "$value": "16px" }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Round: every step softer than the core's",
    "sm": { "$value": "8px" },
    "md": { "$value": "12px" },
    "lg": { "$value": "18px" },
    "xl": { "$value": "24px" }
  },
  "font": {
    "$type": "fontFamily",
    "display": { "$value": ["Bricolage Grotesque", "system-ui", "sans-serif"] },
    "sans": { "$value": ["Bricolage Grotesque", "system-ui", "sans-serif"] },
    "mono": { "$value": ["IBM Plex Mono", "ui-monospace", "monospace"] }
  },
  "border": {
    "width": { "$value": "1px", "$description": "Hairline rules inside" },
    "frame": {
      "$value": "2px",
      "$description": "A heavier frame round cards, overlays and dialogs"
    }
  },
  "control": {
    "$type": "dimension",
    "$description": "Pills for what you press, soft corners for what you fill in or read",
    "button": { "$value": "{radius.pill}" },
    "item": { "$value": "{radius.md}" },
    "field": { "$value": "{radius.md}" },
    "card": { "$value": "{radius.lg}" },
    "overlay": { "$value": "{radius.lg}" },
    "dialog": { "$value": "{radius.xl}" },
    "bar": { "$value": "{radius.pill}" }
  },
  "text": {
    "$type": "typography",
    "$description": "Control type one step up from the core's, to suit the roomier controls",
    "control-xs": { "$value": { "fontSize": "13px", "lineHeight": "18px", "fontWeight": 400 } },
    "control-sm": { "$value": { "fontSize": "14px", "lineHeight": "20px", "fontWeight": 400 } },
    "control-md": { "$value": { "fontSize": "15px", "lineHeight": "22px", "fontWeight": 400 } },
    "control-lg": { "$value": { "fontSize": "17px", "lineHeight": "24px", "fontWeight": 400 } }
  }
}
