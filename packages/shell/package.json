{
  "name": "@hansenexus/shell",
  "version": "0.1.0",
  "description": "hansenexus app shell: floating panels with nav, header, main and an optional context pane, a ⌘K container that takes external command sets or a whole palette, and capability-based nav visibility. Semantic tokens only.",
  "license": "MIT",
  "keywords": [
    "react",
    "app-shell",
    "command-palette",
    "tailwindcss",
    "design-system"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hansenexus/design.git",
    "directory": "packages/shell"
  },
  "bugs": "https://github.com/hansenexus/design/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "test": "bun test tests"
  },
  "dependencies": {
    "radix-ui": "1.6.7"
  },
  "peerDependencies": {
    "@hansenexus/tokens": "^0.4.0",
    "@hansenexus/ui": "^0.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@hansenexus/tokens": "workspace:*",
    "@hansenexus/ui": "workspace:*",
    "@tailwindcss/cli": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3"
  }
}
