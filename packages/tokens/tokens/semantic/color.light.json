{
  "surface": {
    "$type": "color",
    "page": { "$value": "{palette.warm.50}", "$description": "Grund" },
    "band": { "$value": "{palette.warm.100}", "$description": "Band: rail, alternate sections" },
    "card": { "$value": "{palette.warm.25}", "$description": "Fläche" },
    "raised": { "$value": "{palette.warm.125}", "$description": "Erhöht: chips, active nav" },
    "tint": { "$value": "{palette.lime.100}", "$description": "Tönung: icon ground" }
  },
  "ink": {
    "$type": "color",
    "primary": { "$value": "{palette.warm.900}", "$description": "Text: headings" },
    "body": { "$value": "{palette.warm.700}", "$description": "gedämpft: running text" },
    "muted": { "$value": "{palette.warm.600}", "$description": "leise: labels, meta" }
  },
  "line": {
    "$type": "color",
    "subtle": {
      "$value": "{palette.warm.200}",
      "$description": "Linie: dividers, decoration only"
    },
    "strong": { "$value": "{palette.warm.500}", "$description": "Rand stark: secondary borders" }
  },
  "action": {
    "$type": "color",
    "primary": {
      "$value": "{palette.lime.500}",
      "$description": "Primary fill, always with dark text"
    },
    "primary-hover": { "$value": "{palette.lime.300}" },
    "primary-ink": { "$value": "{palette.warm.900}", "$description": "Text on the lime fill" },
    "text": { "$value": "{palette.lime.700}", "$description": "Lime as text on light" },
    "text-hover": { "$value": "{palette.lime.800}" },
    "danger": { "$value": "{palette.coral.700}", "$description": "Destructive fill (Scale to 2)" },
    "danger-ink": { "$value": "{palette.warm.25}", "$description": "Text on the danger fill" }
  },
  "status": {
    "$type": "color",
    "ok": { "$value": "{palette.lime.700}", "$description": "filled dot" },
    "busy": { "$value": "{palette.sky.700}", "$description": "open ring" },
    "warn": { "$value": "{palette.amber.700}", "$description": "triangle" },
    "crit": { "$value": "{palette.coral.700}", "$description": "diamond" },
    "off": {
      "$value": "{palette.warm.600}",
      "$description": "hollow circle. A shape colour only; label text uses ink.muted."
    },
    "unknown": { "$value": "{palette.warm.600}", "$description": "dashed circle" }
  },
  "skeleton": {
    "$type": "color",
    "$description": "Loading placeholders. A pulse runs from base to highlight; reduced motion keeps base.",
    "base": { "$value": "{palette.warm.200}", "$description": "The resting placeholder fill" },
    "highlight": { "$value": "{palette.warm.300}", "$description": "The pulse's far end" }
  },
  "terminal": {
    "$type": "color",
    "$description": "The 16 ANSI colours of a terminal drawn on surface.page or surface.card. Every one is text-contrast (4.5:1) on both. Lime is green, as elsewhere; magenta and cyan are muted so lime stays the only accent.",
    "black": { "$value": "{palette.warm.900}" },
    "red": { "$value": "{palette.coral.700}" },
    "green": { "$value": "{palette.lime.700}" },
    "yellow": { "$value": "{palette.amber.700}" },
    "blue": { "$value": "{palette.sky.700}" },
    "magenta": { "$value": "{palette.plum.700}" },
    "cyan": { "$value": "{palette.teal.700}" },
    "white": {
      "$value": "{palette.warm.600}",
      "$description": "The lightest grey that stays 4.5:1"
    },
    "bright-black": { "$value": "{palette.warm.650}" },
    "bright-red": {
      "$value": "{palette.coral.800}",
      "$description": "On light, bright is one step deeper: lighter would fall below 4.5:1"
    },
    "bright-green": { "$value": "{palette.lime.800}" },
    "bright-yellow": { "$value": "{palette.amber.800}" },
    "bright-blue": { "$value": "{palette.sky.800}" },
    "bright-magenta": { "$value": "{palette.plum.800}" },
    "bright-cyan": { "$value": "{palette.teal.800}" },
    "bright-white": {
      "$value": "{palette.warm.550}",
      "$description": "Lighter than white yet still 4.5:1"
    }
  },
  "focus": {
    "ring": { "$type": "color", "$value": "{palette.lime.700}" }
  },
  "brand": {
    "$type": "color",
    "$description": "The mark and wordmark. The same in both modes: a logo does not follow the theme.",
    "lime": { "$value": "{palette.lime.500}", "$description": "The mark, flat lime" },
    "lime-deep": {
      "$value": "{palette.lime.700}",
      "$description": "The mark on light surfaces where lime would fall below 3:1"
    },
    "ink": { "$value": "{palette.warm.900}", "$description": "Flat ink mark; the app icon ground" },
    "paper": { "$value": "{palette.warm.50}", "$description": "Flat paper mark on ink" }
  }
}
