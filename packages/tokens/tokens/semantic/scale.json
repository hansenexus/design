{
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "12": { "$value": "48px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "6px" },
    "md": { "$value": "10px" },
    "lg": { "$value": "14px" },
    "xl": { "$value": "18px" },
    "pill": { "$value": "999px" }
  },
  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": ["Fraunces", "Georgia", "serif"],
      "$description": "Page titles and big numbers"
    },
    "sans": { "$value": ["Instrument Sans", "system-ui", "sans-serif"], "$description": "The UI" },
    "mono": {
      "$value": ["JetBrains Mono", "ui-monospace", "monospace"],
      "$description": "Hostnames, IPs, tickets, SHAs"
    }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": "120ms", "$description": "hover, press, toggles" },
    "base": { "$value": "200ms", "$description": "panels, inspector, palette" },
    "slow": { "$value": "320ms", "$description": "route change, confirm sheet" }
  },
  "focus": {
    "width": { "$type": "dimension", "$value": "2px" },
    "offset": { "$type": "dimension", "$value": "2px" }
  },
  "shadow": {
    "lift": {
      "$type": "shadow",
      "$description": "The one neutral lift. No coloured shadows, no glow.",
      "$value": {
        "color": "#000000b3",
        "offsetX": "0px",
        "offsetY": "30px",
        "blur": "60px",
        "spread": "-30px"
      }
    }
  }
}
