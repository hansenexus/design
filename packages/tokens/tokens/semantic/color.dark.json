{
  "surface": {
    "$type": "color",
    "page": { "$value": "{palette.warm.900}", "$description": "Grund" },
    "band": { "$value": "{palette.warm.850}", "$description": "Band: rail, alternate sections" },
    "card": { "$value": "{palette.warm.800}", "$description": "Fläche" },
    "raised": { "$value": "{palette.warm.750}", "$description": "Erhöht: chips, active nav" },
    "tint": { "$value": "{palette.lime.950}", "$description": "Tönung: icon ground" }
  },
  "ink": {
    "$type": "color",
    "primary": { "$value": "{palette.warm.50}", "$description": "Text: headings" },
    "body": { "$value": "{palette.warm.300}", "$description": "gedämpft: running text" },
    "muted": { "$value": "{palette.warm.400}", "$description": "leise: labels, meta" }
  },
  "line": {
    "$type": "color",
    "subtle": {
      "$value": "{palette.warm.700}",
      "$description": "Linie: dividers, decoration only"
    },
    "strong": {
      "$value": "{palette.warm.500}",
      "$description": "Rand stark: secondary borders. warm.600 fails 3:1 on band, card and raised."
    }
  },
  "action": {
    "$type": "color",
    "primary": { "$value": "{palette.lime.500}", "$description": "Primary fill" },
    "primary-hover": { "$value": "{palette.lime.300}" },
    "primary-ink": { "$value": "{palette.warm.900}", "$description": "Text on the lime fill" },
    "text": { "$value": "{palette.lime.500}", "$description": "Links, text actions" },
    "text-hover": { "$value": "{palette.lime.300}" },
    "danger": { "$value": "{palette.coral.400}", "$description": "Destructive fill (Scale to 2)" },
    "danger-ink": { "$value": "{palette.warm.900}", "$description": "Text on the danger fill" }
  },
  "status": {
    "$type": "color",
    "ok": { "$value": "{palette.lime.500}", "$description": "filled dot" },
    "busy": { "$value": "{palette.sky.300}", "$description": "open ring" },
    "warn": { "$value": "{palette.amber.400}", "$description": "triangle" },
    "crit": { "$value": "{palette.coral.400}", "$description": "diamond" },
    "off": {
      "$value": "{palette.warm.500}",
      "$description": "hollow circle. A shape colour only; label text uses ink.muted."
    },
    "unknown": { "$value": "{palette.warm.400}", "$description": "dashed circle" }
  },
  "skeleton": {
    "$type": "color",
    "$description": "Loading placeholders. A pulse runs from base to highlight; reduced motion keeps base.",
    "base": { "$value": "{palette.warm.700}", "$description": "The resting placeholder fill" },
    "highlight": { "$value": "{palette.warm.650}", "$description": "The pulse's far end" }
  },
  "terminal": {
    "$type": "color",
    "$description": "The 16 ANSI colours of a terminal drawn on surface.page or surface.card. Every one is text-contrast (4.5:1) on both. Lime is green, as elsewhere; magenta and cyan are muted so lime stays the only accent.",
    "black": {
      "$value": "{palette.warm.450}",
      "$description": "The lowest grey that stays 4.5:1 on surface.card"
    },
    "red": { "$value": "{palette.coral.400}" },
    "green": { "$value": "{palette.lime.500}" },
    "yellow": { "$value": "{palette.amber.400}" },
    "blue": { "$value": "{palette.sky.300}" },
    "magenta": { "$value": "{palette.plum.300}" },
    "cyan": { "$value": "{palette.teal.300}" },
    "white": { "$value": "{palette.warm.300}" },
    "bright-black": { "$value": "{palette.warm.400}" },
    "bright-red": { "$value": "{palette.coral.300}" },
    "bright-green": { "$value": "{palette.lime.300}" },
    "bright-yellow": { "$value": "{palette.amber.300}" },
    "bright-blue": { "$value": "{palette.sky.200}" },
    "bright-magenta": { "$value": "{palette.plum.200}" },
    "bright-cyan": { "$value": "{palette.teal.200}" },
    "bright-white": { "$value": "{palette.warm.50}" }
  },
  "focus": {
    "ring": { "$type": "color", "$value": "{palette.lime.500}" }
  },
  "brand": {
    "$type": "color",
    "$description": "The mark and wordmark. The same in both modes: a logo does not follow the theme.",
    "lime": { "$value": "{palette.lime.500}", "$description": "The mark, flat lime" },
    "lime-deep": {
      "$value": "{palette.lime.700}",
      "$description": "The mark on light surfaces where lime would fall below 3:1"
    },
    "ink": { "$value": "{palette.warm.900}", "$description": "Flat ink mark; the app icon ground" },
    "paper": { "$value": "{palette.warm.50}", "$description": "Flat paper mark on ink" }
  }
}
